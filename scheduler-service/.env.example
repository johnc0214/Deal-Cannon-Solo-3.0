# Copy to scheduler-service/.env for scheduler local development.
# This is for the Node/Cloud Run scheduler service only.

PORT=8080
DEAL_CANNON_INTERNAL_SECRET=
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback
BACKEND_SERVICE_ACCOUNT_EMAIL=
SCHEDULER_SERVICE_PUBLIC_BASE_URL=http://localhost:8080
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=

# Future GHL/n8n integration; scheduler-service does not currently read these yet.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
